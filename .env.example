# ─────────────────────────────────────────────────────────────────
# BETZ360 ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────
# IMPORTANT: never commit a real .env file. Copy this to .env and
# fill in real values. The .env file is gitignored.
#
# Server-only secrets (no VITE_ prefix — these stay server-side and
# are NOT bundled into the public frontend code):
# ─────────────────────────────────────────────────────────────────

# The Odds API — server-only, never exposed to client
ODDS_API_KEY=your_odds_api_key_here

# ─────────────────────────────────────────────────────────────────
# Frontend-safe variables (VITE_ prefix means they ARE in the
# public bundle — only put non-sensitive keys here, like public
# weather APIs that have rate limits but no abuse risk).
# ─────────────────────────────────────────────────────────────────

# OpenWeather (public — used client-side for MLB venue weather)
VITE_WEATHER_API_KEY=your_openweather_api_key_here

# ─────────────────────────────────────────────────────────────────
# Configure these in Netlify:
#   Site Settings → Environment variables → Add variable
# ─────────────────────────────────────────────────────────────────
